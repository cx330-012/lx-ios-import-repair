diff --git a/ios/LxMusicMobile/LXDocumentPicker.m b/ios/LxMusicMobile/LXDocumentPicker.m
new file mode 100644
index 0000000..e533b3e
--- /dev/null
+++ b/ios/LxMusicMobile/LXDocumentPicker.m
@@ -0,0 +1,160 @@
+#import <React/RCTBridgeModule.h>
+#import <React/RCTUtils.h>
+#import <UIKit/UIKit.h>
+
+// Import a user-selected document into the app's cache before JS reads it.
+// The Android storage module used by LX is intentionally not linked on iOS.
+@interface LXDocumentPicker : NSObject <RCTBridgeModule, UIDocumentPickerDelegate>
+@property(nonatomic, copy) RCTPromiseResolveBlock pendingResolve;
+@property(nonatomic, copy) RCTPromiseRejectBlock pendingReject;
+@property(nonatomic, copy) NSString *importDirectory;
+@property(nonatomic, strong) UIDocumentPickerViewController *picker;
+@end
+
+@implementation LXDocumentPicker
+
+RCT_EXPORT_MODULE(LXDocumentPicker)
+
++ (BOOL)requiresMainQueueSetup
+{
+  return YES;
+}
+
+- (dispatch_queue_t)methodQueue
+{
+  return dispatch_get_main_queue();
+}
+
+- (void)clearPending
+{
+  self.pendingResolve = nil;
+  self.pendingReject = nil;
+  self.importDirectory = nil;
+  self.picker = nil;
+}
+
+- (void)finishWithResult:(id)result
+{
+  RCTPromiseResolveBlock resolve = self.pendingResolve;
+  [self clearPending];
+  if (resolve) resolve(result);
+}
+
+- (void)finishWithError:(NSError *)error
+{
+  RCTPromiseRejectBlock reject = self.pendingReject;
+  [self clearPending];
+  if (reject) reject(@"E_DOCUMENT_IMPORT", error.localizedDescription, error);
+}
+
+RCT_REMAP_METHOD(openDocument,
+                 openDocumentInDirectory:(NSString *)directory
+                 resolver:(RCTPromiseResolveBlock)resolve
+                 rejecter:(RCTPromiseRejectBlock)reject)
+{
+  if (self.pendingResolve) {
+    reject(@"E_DOCUMENT_BUSY", @"A document picker is already open.", nil);
+    return;
+  }
+  UIViewController *presenter = RCTPresentedViewController();
+  if (!presenter || !presenter.view.window || presenter.isBeingDismissed) {
+    reject(@"E_DOCUMENT_PRESENT", @"Cannot open the document picker. Please try again.", nil);
+    return;
+  }
+
+  self.pendingResolve = resolve;
+  self.pendingReject = reject;
+  self.importDirectory = directory;
+  // public.data includes custom .lxmc and .js files. LX validates extensions
+  // after selection so unregistered custom extensions remain selectable.
+  self.picker = [[UIDocumentPickerViewController alloc]
+    initWithDocumentTypes:@[@"public.data"] inMode:UIDocumentPickerModeOpen];
+  self.picker.delegate = self;
+  self.picker.allowsMultipleSelection = NO;
+  self.picker.modalPresentationStyle = UIModalPresentationFullScreen;
+  @try {
+    [presenter presentViewController:self.picker animated:YES completion:nil];
+  } @catch (NSException *exception) {
+    NSError *error = [NSError errorWithDomain:@"LXDocumentPicker" code:1
+      userInfo:@{NSLocalizedDescriptionKey: exception.reason ?: @"Cannot open document picker."}];
+    [self finishWithError:error];
+  }
+}
+
+- (void)documentPickerWasCancelled:(UIDocumentPickerViewController *)controller
+{
+  [controller dismissViewControllerAnimated:YES completion:^{
+    [self finishWithResult:nil];
+  }];
+}
+
+- (void)documentPicker:(UIDocumentPickerViewController *)controller
+ didPickDocumentsAtURLs:(NSArray<NSURL *> *)urls
+{
+  NSURL *source = urls.firstObject;
+  if (!source) {
+    [self documentPickerWasCancelled:controller];
+    return;
+  }
+  NSString *directory = [self.importDirectory copy];
+  [controller dismissViewControllerAnimated:YES completion:^{
+    // Coordination allows Files/iCloud providers to make the content available.
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+      BOOL scoped = [source startAccessingSecurityScopedResource];
+      NSFileManager *manager = [NSFileManager defaultManager];
+      NSString *folder = [directory stringByAppendingPathComponent:NSUUID.UUID.UUIDString];
+      __block NSString *copiedPath = nil;
+      __block NSDictionary *attributes = nil;
+      __block NSError *copyError = nil;
+      NSError *coordinationError = nil;
+
+      if ([manager createDirectoryAtPath:folder withIntermediateDirectories:YES attributes:nil error:&copyError]) {
+        NSFileCoordinator *coordinator = [[NSFileCoordinator alloc] initWithFilePresenter:nil];
+        [coordinator coordinateReadingItemAtURL:source options:0 error:&coordinationError
+          byAccessor:^(NSURL *readURL) {
+            NSNumber *isDirectory = nil;
+            if (![readURL getResourceValue:&isDirectory forKey:NSURLIsDirectoryKey error:&copyError]) return;
+            if (isDirectory.boolValue) {
+              copyError = [NSError errorWithDomain:@"LXDocumentPicker" code:2
+                userInfo:@{NSLocalizedDescriptionKey: @"Please select a file, not a folder."}];
+              return;
+            }
+            NSString *name = source.lastPathComponent;
+            if (!name.length) name = @"import";
+            NSString *destination = [folder stringByAppendingPathComponent:name];
+            if ([manager copyItemAtURL:readURL toURL:[NSURL fileURLWithPath:destination] error:&copyError]) {
+              copiedPath = destination;
+              attributes = [manager attributesOfItemAtPath:destination error:&copyError];
+            }
+          }];
+      }
+      if (scoped) [source stopAccessingSecurityScopedResource];
+
+      NSError *error = coordinationError ?: copyError;
+      if (!copiedPath && !error) {
+        error = [NSError errorWithDomain:@"LXDocumentPicker" code:3
+          userInfo:@{NSLocalizedDescriptionKey: @"The selected file could not be read."}];
+      }
+      if (error) {
+        [manager removeItemAtPath:folder error:nil];
+        dispatch_async(dispatch_get_main_queue(), ^{ [self finishWithError:error]; });
+        return;
+      }
+      NSDate *modified = attributes[NSFileModificationDate];
+      NSDictionary *result = @{
+        @"name": copiedPath.lastPathComponent,
+        @"path": copiedPath,
+        @"data": copiedPath,
+        @"isDirectory": @NO,
+        @"isFile": @YES,
+        @"canRead": @YES,
+        @"mimeType": @"application/octet-stream",
+        @"size": attributes[NSFileSize] ?: @0,
+        @"lastModified": @(modified ? modified.timeIntervalSince1970 * 1000 : 0),
+      };
+      dispatch_async(dispatch_get_main_queue(), ^{ [self finishWithResult:result]; });
+    });
+  }];
+}
+
+@end
