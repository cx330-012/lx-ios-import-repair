diff --git a/src/utils/iosCompression.js b/src/utils/iosCompression.js
new file mode 100644
index 0000000..2dad7c0
--- /dev/null
+++ b/src/utils/iosCompression.js
@@ -0,0 +1,13 @@
+import { Buffer } from '@craftzdog/react-native-buffer'
+import { gzip, ungzip } from 'pako'
+
+// Keep bytes in base64 across the RNFS bridge, including non-ASCII backups.
+export const gzipBase64 = data => Buffer.from(gzip(Buffer.from(data, 'base64'))).toString('base64')
+
+export const ungzipBase64 = data => {
+  try {
+    return Buffer.from(ungzip(Buffer.from(data, 'base64'))).toString('base64')
+  } catch (error) {
+    throw new Error(`Unable to decompress backup: ${String(error)}`)
+  }
+}
